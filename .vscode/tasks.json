{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All Agent Projects",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--all-packages", "--locked"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Verify Foundry Portal Agents",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${workspaceFolder}/manage_agents.py", "verify"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}